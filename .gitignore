# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python tooling caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging metadata
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Build, distribution and installer artifacts
build/
dist/
out/
output/
Output/
/repo/Output/
*.manifest
*.spec
*.whl
*.zip
*.7z
*.rar
*.tar
*.gz

# PyInstaller artifacts
*.toc
*.pkg

# Nuitka artifacts
*.build/
*.dist/
*.onefile-build/
*.nuitka-project
.nuitka-cache/

# Windows executables and packaged installers
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle

# Runtime data generated by the application
logs/
log/
_internal/logs/
*.log
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
atividades.db
listas.db

# Local files and backups
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*.orig

# IDE/editor local state
.vscode/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
*.code-workspace

# Project paths that must stay visible to Git
!/.github/
!/mocks/
!/repo/
!/source/
!/.gitattributes
!/LICENSE
!/main.py
!/README.md
!/requirements.txt
!/teste1.py
!/.gitignore

# Operating system noise
.DS_Store
Thumbs.db
desktop.ini
